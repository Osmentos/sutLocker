<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="sutlocker.ui.AddEntryController"
      spacing="10" prefWidth="340">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="Новая запись" style="-fx-font-size: 18px;"/>
    <TextField fx:id="serviceField" promptText="Сервис (например, Gmail)"/>
    <TextField fx:id="loginField" promptText="Логин"/>
    <PasswordField fx:id="passwordField" promptText="Пароль"/>
    <Label text="Способ хранения пароля"/>
    <ComboBox fx:id="typeBox" maxWidth="Infinity"/>
    <Button text="Сохранить" maxWidth="Infinity" defaultButton="true" onAction="#onSave"/>
</VBox>