<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="sutlocker.ui.LoginController"
      alignment="CENTER" spacing="10" prefWidth="320">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="Вход в SutLocker" style="-fx-font-size: 18px;"/>
    <TextField fx:id="loginField" promptText="Логин"/>
    <PasswordField fx:id="passwordField" promptText="Пароль"/>
    <Button text="Войти" maxWidth="Infinity" defaultButton="true" onAction="#onLogin"/>
    <Button text="Регистрация" maxWidth="Infinity" onAction="#onRegister"/>
</VBox>